{
	"name": "@azzz9/pi-pstack",
	"version": "0.6.0",
	"description": "pstack for Pi (personal fork of @zenspc/pi-pstack): poteto-mode playbooks, principles, review panels, and subagents.",
	"type": "module",
	"license": "MIT",
	"author": "dhairyaar",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/azzz9/pi-pstack.git"
	},
	"bugs": {
		"url": "https://github.com/azzz9/pi-pstack/issues"
	},
	"homepage": "https://github.com/azzz9/pi-pstack#readme",
	"publishConfig": {
		"access": "public"
	},
	"keywords": [
		"pi-package",
		"pi-extension",
		"skills",
		"workflow",
		"principles",
		"poteto-mode",
		"subagents",
		"unslop"
	],
	"files": [
		"extensions/",
		"!extensions/**/*.test.ts",
		"skills/",
		"agents/",
		"README.md",
		"LICENSE",
		"FORK.md",
		"scripts/",
		"upstream.lock.json"
	],
	"peerDependencies": {
		"@earendil-works/pi-coding-agent": "*"
	},
	"pi": {
		"extensions": [
			"./extensions/pstack/index.ts"
		],
		"skills": [
			"./skills"
		],
		"subagents": {
			"agents": [
				"./agents"
			]
		}
	},
	"scripts": {
		"test": "node --experimental-strip-types --test extensions/pstack/*.test.ts skills/poteto-mode/scripts/check-plan.test.mjs scripts/reground-from-cursor.test.mjs scripts/poteto-load-audit.test.mjs scripts/check-upstream.test.mjs",
		"reground": "node --experimental-strip-types scripts/reground-from-cursor.mjs",
		"check-upstream": "node scripts/check-upstream.mjs"
	}
}
